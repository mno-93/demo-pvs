{
  "name": "demo-pvs",
  "version": "0.1.0",
  "private": true,
  "description": "Demo-Praxisverwaltungssystem zur ePA EU Patient Summary — fiktives System, keine Produktabbildung",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start": "npm run dev",
    "dev": "node werkzeuge/entwicklung-starten.mjs",
    "dev:pvs": "npm run dev --workspace @demo-pvs/pvs",
    "dev:epa": "npm run dev --workspace @demo-pvs/epa-sim",
    "build": "npm run build --workspaces --if-present",
    "build:gehostet": "VITE_SIMULATOR=browser npm run build && cp packages/pvs/dist/index.html packages/pvs/dist/404.html",
    "vorschau:gehostet": "npm run vorschau --workspace @demo-pvs/pvs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --build --force",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "pruefen": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run pruefen:vertraulich",
    "predev": "npm run build --workspace @demo-pvs/kern",
    "pruefen:vertraulich": "node werkzeuge/vertraulich-pruefen.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.1.0"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "esbuild@0.25.12": true
  }
}
